# .env NAS/VPN (JSON locale): copia in .env e compila. MAI committare il .env reale.
# Deploy: NAS in LAN, accesso esterno SOLO via VPN (Tailscale/WireGuard). Niente port-forward.
# Per Vercel+Supabase vedi .env.vercel.example (DB cloud, niente DATA_DIR).

# --- Server ---
PORT=3000
DATA_DIR=/app/data
NODE_ENV=production
# Origini frontend consentite (CORS). Esempi LAN + Tailnet:
ALLOWED_ORIGIN=http://192.168.1.50:8080,http://100.64.0.10:8080

# --- Database: JSON locale (default) oppure Supabase ---
# Se compili queste DUE variabili, il backend usa Supabase/Postgres al posto del
# file JSON (utile per il deploy su Vercel, o per condividere i dati tra più server).
# Per attivarle: esegui supabase/schema.sql nel SQL Editor del progetto Supabase.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # solo server, mai nel frontend
# Migrazione dei dati: GET /api/data/export → POST /api/data/import (vedi README).

# --- Chiavi cloud (restano sul server, mai nel frontend) ---
# Gemini API (https://ai.google.dev)
GEMINI_API_KEY=
# OpenRouter (https://openrouter.io)
OPENROUTER_API_KEY=

# --- Ollama opzionale (ascolto locale) ---
# LAN (container -> PC): http://host.docker.internal:11434
# VPN (NAS -> PC via Tailscale): http://100.x.y.z:11434  (IP Tailscale del PC)
# Solo NAS (profilo ollama-cpu): http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Tool-calling: qwen2.5:3b-instruct, qwen2.5:7b-instruct, llama3.1:8b-instruct, mistral-nemo.
# Evitare phi/orca-mini (niente tool nativi, solo fallback JSON).
OLLAMA_MODEL=qwen2.5:3b-instruct

# --- Frontend (solo dev locale; in Docker viene bakato a /api) ---
VITE_API_URL=/api

# --- Telegram bot (ponte telefono <-> sito, vedi TELEGRAM-SETUP.md) ---
# Metti il token di @BotFather nel file .env (MAI committarlo):
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_IDS=123456789
# API_BASE_URL=http://localhost:3000/api
