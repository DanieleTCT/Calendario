# .env per deploy Vercel + Supabase (DB cloud).
# Su Vercel NON usare file: imposta queste come Environment Variables
# (Project Settings > Environment Variables). MAI committare valori reali.
# Prima: esegui supabase/schema.sql nel SQL Editor del progetto Supabase.

# --- Database (Supabase) — OBBLIGATORIE su Vercel ---
# URL progetto: https://<ref>.supabase.co  (Project Settings > Data API)
SUPABASE_URL=
# Chiave SERVICE_ROLE (bypassa RLS, resta SOLO sul server — MAI esporla al browser!)
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS: dominio pubblico del frontend (una volta deployato) ---
# Es: ALLOWED_ORIGIN=https://sito-calendario.vercel.app
ALLOWED_ORIGIN=

# --- Chiavi AI (restano sul server, mai nel frontend) ---
# Gemini API (https://ai.google.dev)
GEMINI_API_KEY=
# OpenRouter (https://openrouter.io)
OPENROUTER_API_KEY=

# --- Ollama / modelli locali: NON disponibili su Vercel serverless ---
# (localhost del cloud non è il tuo PC). Su Vercel usa Gemini/OpenRouter/Demo.
# OLLAMA_BASE_URL=  # ignorata su Vercel
# OLLAMA_MODEL=     # ignorata su Vercel

# --- Frontend (progetto Vercel statico: punta all'URL pubblico dell'API) ---
# Es: VITE_API_URL=https://sito-calendario-api.vercel.app/api
VITE_API_URL=

# --- Telegram (opzionale): il bot long-polling gira sul tuo PC/NAS, non su Vercel ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_IDS=
# API_BASE_URL=https://<tuo-api>.vercel.app/api
